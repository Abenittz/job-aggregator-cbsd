# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/job-aggregation

# JWT Configuration
# IMPORTANT: JWT_SECRET must be at least 32 characters long
# Generate a secure secret using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long-replace-this

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
